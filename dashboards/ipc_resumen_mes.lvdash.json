{
  "datasets": [
    {
      "name": "ds_kpi_total",
      "displayName": "kpi_total",
      "queryLines": [
        "SELECT fecha,\n",
        "       ROUND(variacion_mensual, 2)            AS mensual,\n",
        "       ROUND(variacion_anual, 2)              AS anual,\n",
        "       ROUND(variacion_anio_corrido, 2)       AS anio_corrido,\n",
        "       ROUND(cambio_anual_vs_mes_anterior, 2) AS cambio_anual_pp\n",
        "FROM ipc.gold.resumen_kpi\n",
        "WHERE nivel_ingresos = 'Total Nivel de Ingresos'"
      ]
    },
    {
      "name": "ds_kpi_ingresos",
      "displayName": "kpi_ingresos",
      "queryLines": [
        "SELECT date_format(fecha, 'yyyy-MM')          AS mes,\n",
        "       nivel_ingresos, orden_ingreso,\n",
        "       ROUND(variacion_mensual, 2)            AS mensual,\n",
        "       ROUND(variacion_anual, 2)              AS anual,\n",
        "       ROUND(variacion_anio_corrido, 2)       AS anio_corrido,\n",
        "       ROUND(cambio_anual_vs_mes_anterior, 2) AS cambio_anual_pp\n",
        "FROM ipc.gold.resumen_kpi\n",
        "ORDER BY orden_ingreso"
      ]
    },
    {
      "name": "ds_top_contribucion",
      "displayName": "top_contribucion",
      "queryLines": [
        "SELECT nivel_ingresos, nombre, division_nombre,\n",
        "       ROUND(variacion_anual, 2)     AS variacion_anual,\n",
        "       ROUND(contribucion_anual, 3)  AS contribucion_pp,\n",
        "       ROUND(participacion_anual, 1) AS participacion_pct\n",
        "FROM ipc.gold.resumen_ranking\n",
        "WHERE rank_mayor_contribucion_anual <= 10"
      ]
    },
    {
      "name": "ds_top_alzas_mes",
      "displayName": "top_alzas_mes",
      "queryLines": [
        "SELECT nivel_ingresos, nombre, division_nombre,\n",
        "       ROUND(variacion_mensual, 2) AS variacion_mensual\n",
        "FROM ipc.gold.resumen_ranking\n",
        "WHERE rank_mayor_alza_mensual <= 10"
      ]
    },
    {
      "name": "ds_top_bajas_mes",
      "displayName": "top_bajas_mes",
      "queryLines": [
        "SELECT nivel_ingresos, nombre, division_nombre,\n",
        "       ROUND(variacion_mensual, 2) AS variacion_mensual\n",
        "FROM ipc.gold.resumen_ranking\n",
        "WHERE rank_mayor_baja_mensual <= 10"
      ]
    },
    {
      "name": "ds_brecha_pa_ultimo",
      "displayName": "brecha_pa_ultimo",
      "queryLines": [
        "SELECT ROUND(brecha_anual, 2)                   AS brecha_pp,\n",
        "       ROUND(cambio_brecha_vs_mes_anterior, 2)  AS vs_mes_anterior,\n",
        "       ROUND(cambio_brecha_vs_anio_anterior, 2) AS vs_anio_anterior\n",
        "FROM ipc.gold.resumen_brechas\n",
        "WHERE tipo = 'pobres_vs_altos' AND nivel_canasta = 'Total'"
      ]
    },
    {
      "name": "ds_serie_ingresos",
      "displayName": "serie_ingresos",
      "queryLines": [
        "SELECT fecha, nivel_ingresos, orden_ingreso,\n",
        "       ROUND(variacion_anual, 2) AS anual\n",
        "FROM ipc.gold.ipc_consulta\n",
        "WHERE ciudad = 'NACIONAL' AND nivel_canasta = 'Total' AND variacion_anual IS NOT NULL"
      ]
    },
    {
      "name": "ds_serie_brecha_pa",
      "displayName": "serie_brecha_pa",
      "queryLines": [
        "SELECT fecha, ROUND(brecha_anual, 2) AS brecha_pp\n",
        "FROM ipc.gold.brechas\n",
        "WHERE tipo = 'pobres_vs_altos' AND nivel_canasta = 'Total' AND brecha_anual IS NOT NULL"
      ]
    },
    {
      "name": "ds_brechas_ciudad",
      "displayName": "brechas_ciudad",
      "queryLines": [
        "SELECT grupo AS ciudad,\n",
        "       ROUND(variacion_anual_grupo, 2) AS inflacion_anual,\n",
        "       ROUND(brecha_anual, 2)          AS brecha_pp\n",
        "FROM ipc.gold.resumen_brechas\n",
        "WHERE tipo = 'ciudad' AND nivel_canasta = 'Total'"
      ]
    },
    {
      "name": "ds_brecha_pa_division",
      "displayName": "brecha_pa_division",
      "queryLines": [
        "SELECT nombre AS division, ROUND(brecha_anual, 2) AS brecha_pp\n",
        "FROM ipc.gold.resumen_brechas\n",
        "WHERE tipo = 'pobres_vs_altos' AND nivel_canasta = 'Division'"
      ]
    }
  ],
